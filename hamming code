# Hamming Code - Error Detection and Correction

def generate_hamming(data):
    m = len(data)
    r = 0

    while 2**r < m + r + 1:
        r += 1

    n = m + r
    h = [0] * (n + 1)

    # Insert data bits
    j = 0
    for i in range(1, n + 1):
        if i & (i - 1):  # not a power of 2
            h[i] = int(data[j])
            j += 1

    # Calculate parity bits
    p = 1
    while p <= n:
        x = 0

        for i in range(1, n + 1):
            if i & p:
                x ^= h[i]

        h[p] = x
        p *= 2

    return h


def detect_correct(h):
    n = len(h) - 1
    error = 0
    p = 1

    while p <= n:
        x = 0

        for i in range(1, n + 1):
            if i & p:
                x ^= h[i]

        if x:
            error += p

        p *= 2

    if error:
        print("\nError detected at position:", error)
        h[error] ^= 1
        print("Error corrected successfully.")
    else:
        print("\nNo error detected.")

    return h


# Main program
data = input("Enter data bits: ")
hamming = generate_hamming(data)

n = len(hamming) - 1

print("\n----- TRANSMITTER SIDE -----")
print("Original Data:", data)

print("Positions: ", end="")
for i in range(n, 0, -1):
    print(i, end=" ")

print("\nHamming Code:", end=" ")
for i in range(n, 0, -1):
    print(hamming[i], end="")

print()

print("\n----- RECEIVER SIDE -----")
s = input("Enter received codeword: ")

received = [0] * (n + 1)

for j, i in enumerate(range(n, 0, -1)):
    received[i] = int(s[j])

corrected = detect_correct(received)

print("Corrected Code:", end=" ")
for i in range(n, 0, -1):
    print(corrected[i], end="")

print()
